+// A call returning `Updates`, and a call wrapping one, takes a reply that was already
+// decoded as the value it was given. Any other call gives that same value back.
+#[test]
+fn decoded_return_hooks_forward_ownership() {
+    use crate::RemoteCall;
+    use crate::functions::InvokeWithLayer;
+    use crate::functions::messages::{GetHistory, SendMessage};
+
+    fn updates() -> Box<types::Updates> {
+        Box::new(types::Updates {
+            updates: vec![types::UpdateChannel { channel_id: 7 }.into()],
+            users: Vec::new(),
+            chats: Vec::new(),
+            date: 123,
+            seq: 9,
+        })
+    }
+    fn check<F: RemoteCall<Return = enums::Updates>>() {
+        assert!(F::returns_updates());
+        let full = updates();
+        let pointer = full.updates.as_ptr();
+        let enums::Updates::Updates(full) = F::return_from_updates(full).unwrap() else {
+            panic!("expected full updates");
+        };
+        assert_eq!(full.updates.as_ptr(), pointer);
+        assert_eq!(full.date, 123);
+    }
+    check::<SendMessage>();
+    check::<InvokeWithLayer<InvokeWithLayer<SendMessage>>>();
+
+    type Other = InvokeWithLayer<GetHistory>;
+    assert!(!Other::returns_updates());
+    let original = updates();
+    let pointer = std::ptr::from_ref(&*original);
+    let rejected = Other::return_from_updates(original).unwrap_err();
+    assert_eq!(std::ptr::from_ref(&*rejected), pointer);
+}
