+/// What the caller of a request is sent when it succeeds.
+pub(crate) enum Reply {
+    /// The reply's bytes, for the caller to decode.
+    Bytes(Vec<u8>),
+    /// The reply as its connection decoded it for the stream of updates: a copy of that
+    /// value, holding the same messages. Only the `updates` constructor: a short reply
+    /// is small to decode and the other constructors are rare.
+    Updates {
+        updates: Box<tl::types::Updates>,
+        /// The bytes it was decoded from, for a caller whose return type it is not.
+        original: Vec<u8>,
+    },
+}
+
+/// Where the outcome of a request goes.
+///
+/// A caller that will decode its reply as a known type asks for [`Reply`]: when the
+/// connection decodes that reply for the stream of updates anyway, the caller is sent a
+/// copy of the value and the reply is decoded once, not twice. Every other caller is
+/// sent the bytes, as before.
+pub(crate) enum ReplySender {
+    Bytes(oneshot::Sender<Result<Vec<u8>, InvocationError>>),
+    Decoded(oneshot::Sender<Result<Reply, InvocationError>>),
+}
+
+impl ReplySender {
+    /// Send the outcome of a request whose reply is given as bytes. `Err` means the
+    /// caller is gone.
+    pub(crate) fn send(self, outcome: Result<Vec<u8>, InvocationError>) -> Result<(), ()> {
+        match self {
+            Self::Bytes(tx) => tx.send(outcome).map_err(drop),
+            Self::Decoded(tx) => tx.send(outcome.map(Reply::Bytes)).map_err(drop),
+        }
+    }
+
+    /// Send a reply this connection already decoded, with the bytes it was decoded
+    /// from. A caller that takes bytes is sent those.
+    pub(crate) fn send_updates(self, updates: Box<tl::types::Updates>, original: Vec<u8>) {
+        match self {
+            Self::Bytes(tx) => {
+                let _ = tx.send(Ok(original));
+            }
+            Self::Decoded(tx) => {
+                let _ = tx.send(Ok(Reply::Updates { updates, original }));
+            }
+        }
+    }
+
+    /// Whether the caller takes a decoded reply.
+    fn takes_decoded(&self) -> bool {
+        matches!(self, Self::Decoded(_))
+    }
+
+    pub(crate) fn is_closed(&self) -> bool {
+        match self {
+            Self::Bytes(tx) => tx.is_closed(),
+            Self::Decoded(tx) => tx.is_closed(),
+        }
+    }
+
+    pub(crate) fn poll_closed(&mut self, cx: &mut std::task::Context<'_>) -> Poll<()> {
+        match self {
+            Self::Bytes(tx) => tx.poll_closed(cx),
+            Self::Decoded(tx) => tx.poll_closed(cx),
+        }
+    }
+}
+
+impl std::fmt::Debug for ReplySender {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        let (name, closed) = match self {
+            Self::Bytes(tx) => ("Bytes", tx.is_closed()),
+            Self::Decoded(tx) => ("Decoded", tx.is_closed()),
+        };
+        f.debug_struct(name).field("closed", &closed).finish()
+    }
+}
