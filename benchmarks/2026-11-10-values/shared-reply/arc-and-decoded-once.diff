+    fn full_message_payload(updates: &tl::types::Updates) -> &std::sync::Arc<tl::types::Message> {
+        updates
+            .updates
+            .iter()
+            .find_map(|update| match update {
+                tl::enums::Update::NewMessage(update) => match &update.message {
+                    tl::enums::Message::Message(message) => Some(message),
