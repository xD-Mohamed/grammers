+        });
+        let waker = Waker::from(Arc::clone(&observation));
+        let mut cx = Context::from_waker(&waker);
+        let mut rx = Box::pin(rx);
+        assert!(rx.as_mut().poll(&mut cx).is_pending());
+        sender
+            .process_mtp_buffer(
+                own_reply(id, &full_message_updates_fixture(), false),
+                &mut Vec::new(),
+            )
+            .unwrap();
+        assert_eq!(observation.seen.load(Ordering::SeqCst), 7);
+        assert!(matches!(rx.await.unwrap().unwrap(), Reply::Updates { .. }));
+    }
 }
