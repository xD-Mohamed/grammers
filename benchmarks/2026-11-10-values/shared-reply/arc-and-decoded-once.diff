+    /// As `sent`, for a caller that takes its reply decoded.
+    fn sent_decoded<M: Mtp>(
+        sender: &mut Sender<transport::Full, M>,
+        body: Vec<u8>,
+        tx: oneshot::Sender<Result<Reply, InvocationError>>,
+        permit: Option<crate::InvocationPermit>,
+    ) -> MsgId {
+        sender.enqueue_tracked_reply(body.into(), ReplySender::Decoded(tx), permit);
+        sender.try_fill_write();
+        sender.on_net_write(sender.write_buffer.len()).unwrap();
+        match &sender.requests.last().unwrap().state {
+            RequestState::Sent(pair) => pair.msg_id,
+            _ => panic!("unsent"),
+        }
+    }
