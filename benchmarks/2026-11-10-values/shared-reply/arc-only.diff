+#[test]
+fn message_payloads_are_shared_but_other_storage_is_preserved() -> io::Result<()> {
+    let definitions = get_definitions(
+        "
+        message#7600b9d3 text:string = Message;
+        messageService#7a800e0a text:string = Message;
+        messageEmpty#90a6ca84 id:int = Message;
+        ephemeralMessage#dd27bee9 text:string = EphemeralMessage;
+        sample.message#70000001 text:string = sample.Message;
+    ",
+    );
+    let (_, types, _, enums) = gen_rust_code(&definitions)?;
+    let types = compact_rust(&types);
+    let enums = compact_rust(&enums);
+    for (variant, payload) in [("Message", "Message"), ("Service", "MessageService")] {
+        let payload = format!("crate::types::{payload}");
+        assert!(enums.contains(&format!("{variant}(std::sync::Arc<{payload}>),")));
+        assert!(enums.contains(&format!(
+            "Self::{variant}(std::sync::Arc::new({payload}::deserialize(buf)?)),"
+        )));
+        assert!(enums.contains(&format!("Message::{variant}(std::sync::Arc::new(x))")));
+        assert!(types.contains(&format!(
+            "crate::enums::Message::{variant}(x)=>Ok(std::sync::Arc::unwrap_or_clone(x)),"
+        )));
+    }
+    // Only those two: the other variant, the other boxed definition and the same name
+    // in a namespace are held as before.
+    assert!(enums.contains("Empty(crate::types::MessageEmpty),"));
+    assert!(enums.contains("Message(Box<crate::types::EphemeralMessage>),"));
+    assert!(enums.contains("Message(crate::types::sample::Message),"));
+    Ok(())
