+
+fn remote_call_impl<'a>(functions: &'a str, declaration: &str) -> &'a str {
+    let start = functions.find(declaration).unwrap();
+    let implementation = &functions[start..];
+    let end = implementation.find("\n}\n").unwrap();
+    &implementation[..end + 2]
+}
