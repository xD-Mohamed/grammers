+// A minimal `message` or `messageService`, ending in the string a test changes.
+fn shared_message_bytes(service: bool) -> Vec<u8> {
+    let mut bytes = Vec::new();
+    if service {
+        id::<types::MessageService>(&mut bytes);
+    } else {
+        id::<types::Message>(&mut bytes);
+    }
+    0u32.serialize(&mut bytes);
+    if !service {
+        0u32.serialize(&mut bytes);
+    }
+    41i32.serialize(&mut bytes);
+    id::<types::PeerUser>(&mut bytes);
+    7i64.serialize(&mut bytes);
+    123i32.serialize(&mut bytes);
+    if service {
+        id::<types::MessageActionChatEditTitle>(&mut bytes);
+    }
+    b"owned text".as_slice().serialize(&mut bytes);
+    bytes
+}
+
+// Sharing changes who owns a message, never its bytes. A clone is the same message
+// until one of the two is changed, and a message taken out of its enum is moved when
+// nothing else holds it and copied when something does.
+#[test]
+fn shared_messages_preserve_wire_ownership_and_snapshots() {
+    use std::sync::Arc;
+    let bytes = shared_message_bytes(false);
+    round_trip::<enums::Message>(&bytes);
+    let original = enums::Message::from_bytes(&bytes).unwrap();
+    let snapshot = original.clone();
+    let (enums::Message::Message(original), enums::Message::Message(mut snapshot)) =
+        (original, snapshot)
+    else {
+        panic!("expected ordinary messages");
+    };
+    assert!(Arc::ptr_eq(&original, &snapshot));
+    Arc::make_mut(&mut snapshot).message.push_str(" changed");
+    assert!(!Arc::ptr_eq(&original, &snapshot));
+    assert_eq!(original.message, "owned text");
+    assert_eq!(snapshot.message, "owned text changed");
+    assert_eq!(enums::Message::Message(original).to_bytes(), bytes);
+
+    for shared in [false, true] {
+        let value = enums::Message::from_bytes(&bytes).unwrap();
+        let retained = shared.then(|| value.clone());
+        let enums::Message::Message(raw) = &value else {
+            panic!("expected message");
+        };
+        let pointer = raw.message.as_ptr();
+        let mut owned = types::Message::try_from(value).unwrap();
+        assert_eq!(owned.message.as_ptr() == pointer, !shared);
+        owned.message.push_str(" changed");
+        if let Some(retained) = retained {
+            assert_eq!(retained.to_bytes(), bytes);
+        }
+    }
+    for end in 0..bytes.len() {
+        assert_error::<enums::Message>(&bytes[..end], Error::UnexpectedEof);
+    }
+}
