@@ -2113,6 +2118,18 @@ pub(crate) mod optimization_tests {
     async fn only_small_update_batches_keep_their_vector() {
         let mut sender = pair_with(mtp::Encrypted::build().finish([0; 256])).await.0;
         let batch = |capacity: usize| Vec::<UpdatesLike>::with_capacity(capacity);
+        // The cap is in bytes. A busy connection's reads deliver up to sixteen updates,
+        // which a vector reaches by doubling: that one must be kept, and the next not.
+        eprintln!(
+            "UpdatesLike={} MAX_RECYCLED_UPDATES={MAX_RECYCLED_UPDATES}",
+            size_of::<UpdatesLike>()
+        );
+        assert!((16..32).contains(&MAX_RECYCLED_UPDATES));
+        sender.recycle_updates(batch(16), 16);
+        assert_eq!(sender.recycled_updates.capacity(), 16);
+        sender.recycled_updates = Vec::new();
+        sender.recycle_updates(batch(32), 32);
+        assert_eq!(sender.recycled_updates.capacity(), 0);
         // A single update is not worth keeping memory for the life of a connection.
         sender.recycle_updates(batch(1), 1);
         assert_eq!(sender.recycled_updates.capacity(), 0);
