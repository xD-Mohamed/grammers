 const READ_CHARGE_UNIT: usize = 2 * 1024;
-/// Update batches kept for the next read, in elements of up to about 2 KiB each.
-const MAX_RECYCLED_UPDATES: usize = 8;
+/// Bytes of update batch kept for the next read: what eight elements took when an
+/// element was about 2 KiB.
+const MAX_RECYCLED_UPDATES_BYTES: usize = 16 * 1024;
+/// Update batches kept for the next read, in elements. An element shrank with the
+/// generated types, and a vector grows by doubling: a count fixed at eight came to
