+    /// A protocol that notes how each written packet was reported to it.
+    struct Reports {
+        inner: mtp::Encrypted,
+        timed: Vec<std::time::Instant>,
+        untimed: usize,
+    }
+
+    impl Mtp for Reports {
+        fn push(&mut self, buffer: &mut DequeBuffer<u8>, request: &[u8]) -> Option<MsgId> {
+            self.inner.push(buffer, request)
+        }
+        fn finalize(&mut self, buffer: &mut DequeBuffer<u8>) -> Option<MsgId> {
+            self.inner.finalize(buffer)
+        }
+        fn deserialize(
+            &mut self,
+            payload: &mut [u8],
+        ) -> Result<Vec<Deserialization>, mtp::DeserializeError> {
+            self.inner.deserialize(payload)
+        }
+        fn on_packet_sent(&mut self, at: std::time::Instant) {
+            self.timed.push(at);
+        }
+        fn on_packet_sent_now(&mut self) {
+            self.untimed += 1;
+        }
+    }
+
+    async fn reporting_pair() -> (Sender<transport::Full, Reports>, tokio::net::TcpStream) {
+        pair_with(Reports {
+            inner: mtp::Encrypted::build().finish([0; 256]),
+            timed: Vec::new(),
+            untimed: 0,
+        })
+        .await
+    }
+
+    /// Queue a ping under each permit and frame them all, with whatever was queued
+    /// before, into one packet. Their callers are returned, still waiting.
+    fn frame_pings(
+        sender: &mut Sender<transport::Full, Reports>,
+        permits: Vec<Option<crate::InvocationPermit>>,
+    ) -> Vec<crate::PendingInvocation> {
+        let mut waiting = Vec::new();
+        for permit in permits {
+            let (tx, receiver) = oneshot::channel();
+            let ping = tl::functions::Ping { ping_id: 1 }.to_bytes();
+            sender.enqueue_tracked_body(ping.into(), tx, permit);
+            waiting.push(crate::PendingInvocation { receiver });
+        }
+        sender.try_fill_write();
+        waiting
+    }
+
+    /// How many of its requests the sender holds as written.
+    fn written(sender: &Sender<transport::Full, Reports>) -> usize {
+        let requests = sender.requests.iter();
+        requests
+            .filter(|request| matches!(request.state, RequestState::Sent(_)))
+            .count()
+    }
+
+    /// The requests of one packet reached the network together. Those with a tracker
+    /// share one reading of the precise clock, taken for the first of them, and the
+    /// protocol is told that reading instead of another being taken for it.
+    #[tokio::test]
+    async fn tracked_requests_of_one_packet_share_one_precise_clock_read() {
+        use std::sync::Arc;
+        let (mut sender, _peer) = reporting_pair().await;
+        let admission = Arc::new(tokio::sync::Semaphore::new(2));
+        let admitted = || Arc::clone(&admission).try_acquire_owned().unwrap();
+        let trackers = [
+            crate::InvocationTracker::default(),
+            crate::InvocationTracker::default(),
+        ];
+        // Untracked, tracked, admitted only, tracked and admitted.
+        let permits = vec![
+            None,
+            trackers[0].try_acquire(),
+            Some(crate::InvocationPermit::with_capacity(None, admitted())),
+            Some(crate::InvocationPermit::with_capacity(
+                trackers[1].try_acquire(),
+                admitted(),
+            )),
+        ];
+        let _waiting = frame_pings(&mut sender, permits);
+        assert_eq!(sender.requests.len(), 4);
+
+        // A packet partly written has not been sent: no clock is read for it yet.
+        sender.on_net_write(1).unwrap();
+        assert_eq!((sender.mtp.timed.len(), sender.mtp.untimed), (0, 0));
+        assert_eq!(written(&sender), 0);
+        for tracker in &trackers {
+            assert_eq!(tracker.stage(), crate::InvocationStage::Pending);
+            assert!(tracker.sent_at().is_none());
+        }
+
+        let before = std::time::Instant::now();
+        sender.on_net_write(sender.write_buffer.len() - 1).unwrap();
+        let after = std::time::Instant::now();
+        let sent = trackers[0].sent_at().expect("written");
+        assert_eq!(trackers[1].sent_at(), Some(sent));
+        // The precise clock: the kernel's last tick is before `before`, unless a tick
+        // fell in these few nanoseconds.
+        assert!(before <= sent && sent <= after);
+        // The protocol was told once, of that reading.
+        assert_eq!(sender.mtp.timed, [sent]);
+        assert_eq!(sender.mtp.untimed, 0);
+        // All four were in that packet.
+        assert_eq!(written(&sender), 4);
+        for tracker in &trackers {
+            assert_eq!(tracker.stage(), crate::InvocationStage::Sent);
+        }
+    }
+
