+async fn sent_message_peer(client: &Client, peer: PeerRef) -> Result<PeerRef, InvocationError> {
+    if peer.id.bare_id().is_some() {
+        return Ok(peer);
+    }
+    let unavailable = || {
+        std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "send succeeded but cached self-user information is unavailable",
+        )
+    };
+    let Some(PeerInfo::User { id, auth, .. }) = client.0.session.peer(peer.id).await? else {
+        return Err(unavailable().into());
+    };
+    Ok(PeerRef {
+        id: PeerId::user(id).ok_or_else(unavailable)?,
+        auth: auth.unwrap_or(peer.auth),
+    })
+}
+
+async fn message_from_send_response(
+    client: &Client,
+    peer: PeerRef,
+    message: InputMessage,
+    random_id: i64,
+    updates: tl::enums::Updates,
+) -> Result<Message, InvocationError> {
+    Ok(match updates {
+        tl::enums::Updates::UpdateShortSentMessage(updates) => {
+            let peer = sent_message_peer(client, peer).await?;
+            Message::from_raw_short_updates(client, updates, message, peer)
+        }
+        updates => {
+            let updates_debug = if enabled!(Level::WARN) {
+                Some(updates.clone())
+            } else {
+                None
+            };
+            match map_random_ids_to_messages(client, peer, &[random_id], updates)
+                .await?
+                .pop()
+                .flatten()
+            {
+                Some(message) => message,
+                None => {
+                    if let Some(updates) = updates_debug {
+                        warn!(
+                            "failed to find just-sent message in response updates; please report this:"
+                        );
+                        warn!("{:#?}", updates);
+                    }
+                    let peer = sent_message_peer(client, peer).await?;
+                    Message::from_raw(
+                        client,
+                        tl::enums::Message::Empty(tl::types::MessageEmpty {
+                            id: 0,
+                            peer_id: Some(peer.id.into()),
+                        }),
+                        Some(peer),
+                        client.empty_peer_map(),
+                    )
+                }
+            }
+        }
+    })
+}
