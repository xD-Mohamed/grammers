+#[test]
+fn calls_returning_updates_take_a_reply_that_is_already_decoded() -> io::Result<()> {
+    let definitions = get_definitions(
+        "
+        updatesTooLong#e317af7e = Updates;
+        boolTrue#997275b5 = Bool;
+        account.updatesTooLong#11111111 = account.Updates;
+        ---functions---
+        invokeWithLayer#da9b0d0d {X:Type} layer:int query:!X = X;
+        messages.sendMessage#22222222 message:string = Updates;
+        messages.setTyping#33333333 = Bool;
+        account.getUpdates#44444444 = account.Updates;
+    ",
+    );
+    let (_, _, functions, _) = gen_rust_code(&definitions)?;
+    eprintln!("{functions}");
+
+    let method = "fn return_from_updates(updates: Box<crate::enums::Updates>) \
+        -> ::core::result::Result<Self::Return, Box<crate::enums::Updates>> {";
+    // From the implementation for `name` to the next one of anything.
+    let implementation = |name: &str| {
+        let start = functions
+            .find(&format!("crate::RemoteCall for {name}"))
+            .unwrap_or_else(|| panic!("no RemoteCall for {name}"));
+        let rest = &functions[start..];
+        &rest[..rest[1..].find("impl").map_or(rest.len(), |end| end + 1)]
+    };
+
+    // The call returning `Updates` takes the value, and the wrapper passes it on.
+    let send = implementation("SendMessage {");
+    assert!(
+        send.contains("type Return = crate::enums::Updates;"),
+        "{send}"
+    );
+    assert!(
+        send.contains(method) && send.contains("Ok(*updates)"),
+        "{send}"
+    );
+    let wrapper = implementation("InvokeWithLayer<X> {");
+    assert!(wrapper.contains(method), "{wrapper}");
+    assert!(
+        wrapper.contains("X::return_from_updates(updates)"),
+        "{wrapper}"
+    );
+
+    // Another type keeps the default, and so does a namespaced type of the same name.
+    assert_eq!(functions.matches(method).count(), 2);
+    assert_eq!(functions.matches("Ok(*updates)").count(), 1);
+    Ok(())
+}
